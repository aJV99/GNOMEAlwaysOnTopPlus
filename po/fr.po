#: prefs.js:31
msgid "General"
msgstr "Général"

#: prefs.js:41
msgid "Appearance"
msgstr "Apparence"

#: prefs.js:42
msgid "Configure the appearance of the border"
msgstr "Configurer l’apparence de la bordure"

#: prefs.js:47
msgid "Use System Accent Color"
msgstr "Utiliser la couleur d’accentuation du système"

#: prefs.js:49
msgid "Match the GNOME desktop accent color."
msgstr "Reprend la couleur d’accentuation du bureau GNOME."

#: prefs.js:50
msgid "Requires GNOME 47 or newer."
msgstr "Nécessite GNOME 47 ou une version ultérieure."

#: prefs.js:65
msgid "Border Thickness"
msgstr "Épaisseur de la bordure"

#: prefs.js:66
msgid "Thickness of the border in pixels"
msgstr "Épaisseur de la bordure en pixels"

#: prefs.js:96
msgid "Border Color"
msgstr "Couleur de la bordure"

#: prefs.js:97
msgid "Used when the system accent color is disabled."
msgstr "Utilisée lorsque la couleur d’accentuation du système est désactivée."

#: prefs.js:108
msgid "Border Opacity"
msgstr "Opacité de la bordure"

#: prefs.js:109
msgid "0 (transparent) to 1 (fully opaque)"
msgstr "De 0 (transparente) à 1 (entièrement opaque)"

#: prefs.js:124
msgid "Corner Radius"
msgstr "Rayon des coins"

#: prefs.js:125
msgid "Corner rounding in pixels"
msgstr "Arrondi des coins en pixels"

#: prefs.js:140
msgid "Pinning"
msgstr "Épinglage"

#: prefs.js:141
msgid "Pin or unpin the focused window"
msgstr "Épingler ou désépingler la fenêtre active"

#: prefs.js:146
msgid "Disabled"
msgstr "Désactivé"

#: prefs.js:159
msgid "Reset to default"
msgstr "Réinitialiser à la valeur par défaut"

#: prefs.js:166
msgid "Toggle Always on Top"
msgstr "Activer ou désactiver « Toujours au premier plan »"

#: prefs.js:167
msgid "Click to set a new shortcut"
msgstr "Cliquer pour définir un nouveau raccourci"

#: prefs.js:176
msgid "Top Bar Button"
msgstr "Bouton de la barre supérieure"

#: prefs.js:177
msgid ""
"Click pins or unpins, middle-click toggles all workspaces, right-click opens "
"these settings"
msgstr ""
"Un clic épingle ou désépingle, un clic du milieu bascule l’affichage sur "
"tous les espaces de travail, un clic droit ouvre ces paramètres"

#: prefs.js:186
msgid "Position"
msgstr "Position"

#: prefs.js:187
msgid "Left"
msgstr "Gauche"

#: prefs.js:187
msgid "Center"
msgstr "Centre"

#: prefs.js:187
msgid "Right"
msgstr "Droite"

#: prefs.js:196
msgid "Order"
msgstr "Ordre"

#: prefs.js:197
msgid "Place among the other items there; 0 is first"
msgstr "Place parmi les autres éléments de cette zone ; 0 est la première"

#: prefs.js:209
msgid "Show on All Workspaces"
msgstr "Afficher sur tous les espaces de travail"

#: prefs.js:210
msgid "Pinned windows follow you across workspaces"
msgstr "Les fenêtres épinglées vous suivent d’un espace de travail à l’autre"

#: prefs.js:221
msgid "Press a Shortcut"
msgstr "Saisir un raccourci"

#: prefs.js:222
msgid "Esc to cancel, Backspace to disable"
msgstr "Échap pour annuler, Retour arrière pour désactiver"

#: prefs.js:228
msgid "Set Shortcut"
msgstr "Définir un raccourci"
