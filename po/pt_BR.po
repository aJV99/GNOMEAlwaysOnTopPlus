#: prefs.js:31
msgid "General"
msgstr "Geral"

#: prefs.js:41
msgid "Appearance"
msgstr "Aparência"

#: prefs.js:42
msgid "Configure the appearance of the border"
msgstr "Configurar a aparência da borda"

#: prefs.js:47
msgid "Use System Accent Color"
msgstr "Usar a cor de realce do sistema"

#: prefs.js:49
msgid "Match the GNOME desktop accent color."
msgstr "Acompanha a cor de realce do ambiente GNOME."

#: prefs.js:50
msgid "Requires GNOME 47 or newer."
msgstr "Requer o GNOME 47 ou mais recente."

#: prefs.js:65
msgid "Border Thickness"
msgstr "Espessura da borda"

#: prefs.js:66
msgid "Thickness of the border in pixels"
msgstr "Espessura da borda em pixels"

#: prefs.js:96
msgid "Border Color"
msgstr "Cor da borda"

#: prefs.js:97
msgid "Used when the system accent color is disabled."
msgstr "Usada quando a cor de realce do sistema está desativada."

#: prefs.js:108
msgid "Border Opacity"
msgstr "Opacidade da borda"

#: prefs.js:109
msgid "0 (transparent) to 1 (fully opaque)"
msgstr "De 0 (transparente) a 1 (totalmente opaca)"

#: prefs.js:124
msgid "Corner Radius"
msgstr "Raio dos cantos"

#: prefs.js:125
msgid "Corner rounding in pixels"
msgstr "Arredondamento dos cantos em pixels"

#: prefs.js:140
msgid "Pinning"
msgstr "Fixar janelas"

#: prefs.js:141
msgid "Pin or unpin the focused window"
msgstr "Fixar ou desafixar a janela em foco"

#: prefs.js:146
msgid "Disabled"
msgstr "Desabilitado"

#: prefs.js:159
msgid "Reset to default"
msgstr "Restaurar o padrão"

#: prefs.js:166
msgid "Toggle Always on Top"
msgstr "Alternar “Sempre na frente das outras janelas”"

#: prefs.js:167
msgid "Click to set a new shortcut"
msgstr "Clique para definir um novo atalho"

#: prefs.js:176
msgid "Top Bar Button"
msgstr "Botão da barra superior"

#: prefs.js:177
msgid ""
"Click pins or unpins, middle-click toggles all workspaces, right-click opens "
"these settings"
msgstr ""
"Clique fixa ou desafixa, clique do meio alterna todos os espaços de "
"trabalho, clique direito abre estas configurações"

#: prefs.js:186
msgid "Position"
msgstr "Posição"

#: prefs.js:187
msgid "Left"
msgstr "Esquerda"

#: prefs.js:187
msgid "Center"
msgstr "Centro"

#: prefs.js:187
msgid "Right"
msgstr "Direita"

#: prefs.js:196
msgid "Order"
msgstr "Ordem"

#: prefs.js:197
msgid "Place among the other items there; 0 is first"
msgstr "Posição entre os demais itens dessa área; 0 é o primeiro"

#: prefs.js:209
msgid "Show on All Workspaces"
msgstr "Mostrar em todos os espaços de trabalho"

#: prefs.js:210
msgid "Pinned windows follow you across workspaces"
msgstr "As janelas fixadas acompanham você pelos espaços de trabalho"

#: prefs.js:221
msgid "Press a Shortcut"
msgstr "Pressione um atalho"

#: prefs.js:222
msgid "Esc to cancel, Backspace to disable"
msgstr "Esc para cancelar, Backspace para desativar"

#: prefs.js:228
msgid "Set Shortcut"
msgstr "Definir atalho"
